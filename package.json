{
  "name": "chattea-fe",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.0.4",
  "scripts": {
    "dev": "turbo run dev",
    "dev:mobile": "turbo run dev --filter=chattea-mobile",
    "dev:web": "turbo run dev --filter=chattea-web",
    "start": "pnpm --filter chattea-mobile start",
    "android": "pnpm --filter chattea-mobile android",
    "ios": "pnpm --filter chattea-mobile ios",
    "audit:all": "pnpm --filter chattea-mobile audit:all",
    "audit:prod": "pnpm --filter chattea-mobile audit:prod",
    "deps:check": "pnpm --filter chattea-mobile deps:check",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "pnpm -r format",
    "format:check": "pnpm -r format:check",
    "test": "turbo run test"
  },
  "devDependencies": {
    "turbo": "2.11.3"
  }
}
